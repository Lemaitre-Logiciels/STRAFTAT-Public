# This .gitignore file used to be placed at the root of your Unity project directory has been reworked to work with the Straftat project setup.
/STRAFTAT/[Ll]ibrary/
/STRAFTAT/[Tt]emp/
/STRAFTAT/[Oo]bj/
/STRAFTAT/[Bb]uild/
/STRAFTAT/[Bb]uilds/
/STRAFTAT/[Ll]ogs/
/STRAFTAT/[Mm]emoryCaptures/
/STRAFTAT/[Uu]ser[Ss]ettings/
/STRAFTAT/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/STRAFTAT/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /STRAFTAT/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Rider cache directory
.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage
*.unitypackage.meta

# Crashlytics generated file
crashlytics-build.properties

# Bakery text: 
STRAFTAT/Assets/Editor/x64/Bakery/.denoiserlog.txt
STRAFTAT/Assets/Editor/x64/Bakery/.denoiserlog.txt.meta
STRAFTAT/Assets/Editor/x64/Bakery/.ftracelog.txt
STRAFTAT/Assets/Editor/x64/Bakery/.ftracelog.txt.meta
STRAFTAT/Assets/Editor/x64/Bakery/.uvgblog.txt
STRAFTAT/Assets/Editor/x64/Bakery/.uvgblog.txt.meta

# AmplifyShaderEditor
STRAFTAT/Assets/AmplifyShaderEditor
STRAFTAT/Assets/AmplifyShaderEditor.meta

# bakery_times:
STRAFTAT/bakery_times.log

# RainbowFoldersRuleset:
RainbowFoldersRuleset.asset
RainbowFoldersRuleset.asset.meta

# ftLocalStorage:
STRAFTAT/Assets/Bakery/ftLocalStorage.asset
STRAFTAT/Assets/Bakery/ftLocalStorage.asset.meta

# ftGlobalStorage:
STRAFTAT/Assets/Bakery/ftGlobalStorage.asset
STRAFTAT/Assets/Bakery/ftGlobalStorage.asset.meta

# _tempScene:
STRAFTAT/Assets/Bakery/_tempScene/LightingData.asset
STRAFTAT/Assets/Bakery/_tempScene/LightingData.asset.meta
STRAFTAT/Assets/Bakery/_tempScene.unity
STRAFTAT/Assets/Bakery/_tempScene.unity.meta
STRAFTAT/Assets/Bakery/_tempScene.meta
STRAFTAT/Assets/DefaultPrefabObjects.asset
STRAFTAT/Assets/DefaultPrefabObjects.asset
STRAFTAT/Assets/Materials/PostProcess/M_DamagePP_0.mat
